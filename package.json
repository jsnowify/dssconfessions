{
  "name": "dssconfessions",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "perf:audit": "node scripts/performance/audit.mjs",
    "perf:snapshot": "node scripts/performance/snapshot.mjs",
    "perf:compare": "node scripts/performance/compare.mjs",
    "perf:feed": "node scripts/performance/feed-latency.cjs",
    "dev": "npm run dev --prefix client",
    "start": "npm start --prefix server",
    "build": "npm run build --prefix client && node scripts/prerender.mjs",
    "lint": "npm run lint --prefix client && npm run lint:type",
    "lint:type": "node scripts/lint-typography.mjs",
    "test": "npm test --prefix server",
    "verify:bots": "node scripts/verify-bots.cjs",
    "verify:updates": "node scripts/verify-story-updates.cjs",
    "check:live": "node scripts/check-live.cjs",
    "brand:build": "node scripts/build-brand-assets.mjs",
    "archive:capture": "node scripts/capture-design-archive.mjs",
    "seo:check": "node scripts/seo-check.mjs",
    "seo:verify": "node scripts/verify-seo.mjs"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "sharp": "^0.35.5"
  }
}
