SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE=your-server-only-service-role-key
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
PORT=5000
CLIENT_URL=http://localhost:5173
# All environments use shared PostgreSQL rate limits.
# RATE_LIMIT_STORE=supabase
# Required for new confession posts and author deletion; generate separately.
DELETE_KEY_PEPPER=
# Required for anonymous reports; never reuse another secret.
REPORT_HASH_SECRET=
# Optional Discord webhook. Never use a VITE_ prefix for server secrets.
# ADMIN_WEBHOOK_URL=https://discord.com/api/webhooks/...
ALLOWED_ORIGIN=http://localhost:5173
# Owner password is stored only as a salted scrypt hash; never store it as plaintext.
BOT_ADMIN_PASSWORD_HASH=
# Independent random server-only session signing secret (32–256 characters).
# Leave auth settings unset to disable access. Never prefix secrets with VITE_.
BOT_ADMIN_SESSION_SECRET=
# Built-in fictional writing needs no AI provider or paid model.
BOT_GENERATOR=local
# Optional independent author secret for bot-only local posting.
BOT_DELETE_KEY_PEPPER=
# Development server timer; enable via npm run bots:enable --prefix server.
BOT_LOCAL_SCHEDULER=0
# Independent secret sent by Vercel cron as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
# Optional legacy provider integration, used only with BOT_GENERATOR=ai.
# Leave both values empty for the built-in bot.
BOT_AI_MODEL=
AI_GATEWAY_API_KEY=
